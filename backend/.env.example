# Copy this file to .env and fill in your values

# App environment: development | production
ENV=development

# Database
DATABASE_URL=postgresql+asyncpg://sedna:sedna@localhost:5432/sedna

# Security — CHANGE THIS in production (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-in-production

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Email (set EMAIL_ENABLED=true and fill SMTP_* for real sending)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sedna.academy
APP_URL=http://localhost:5173
