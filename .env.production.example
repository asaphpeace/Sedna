# Copy to .env on the server and fill in real values. Never commit the real .env.

# ── Domain (used by Caddy for automatic HTTPS via Let's Encrypt) ───────────
DOMAIN=academy.yourcompany.com

# ── Postgres ─────────────────────────────────────────────────────────────
POSTGRES_DB=sedna
POSTGRES_USER=sedna
POSTGRES_PASSWORD=CHANGE-ME-generate-with-openssl-rand-hex-32

# ── Backend (read by pydantic-settings — see backend/app/config.py) ────────
ENV=production
DATABASE_URL=postgresql+asyncpg://sedna:CHANGE-ME-generate-with-openssl-rand-hex-32@db:5432/sedna
SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-hex-32
CORS_ORIGINS=https://academy.yourcompany.com
APP_URL=https://academy.yourcompany.com

# ── Email (leave EMAIL_ENABLED=false until you have real SMTP creds) ───────
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourcompany.com

# ── First admin account (used once by `python -m app.init_db`) ─────────────
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=CHANGE-ME-strong-password
ADMIN_NAME=Your Name
ORG_NAME=Your Company
